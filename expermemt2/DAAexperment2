import random
import time
import matplotlib.pyplot as plt


# -------------------------------------------------
# Naive String Matching
# -------------------------------------------------
def naive_search(text, pattern):
    n = len(text)
    m = len(pattern)

    matches = []
    comparisons = 0

    for i in range(n - m + 1):
        j = 0

        while j < m:
            comparisons += 1

            if text[i + j] != pattern[j]:
                break

            j += 1

        if j == m:
            matches.append(i)

    return matches, comparisons


# -------------------------------------------------
# Compute LPS Array
# -------------------------------------------------
def compute_lps(pattern):
    m = len(pattern)

    lps = [0] * m

    length = 0
    i = 1

    while i < m:

        if pattern[i] == pattern[length]:
            length += 1
            lps[i] = length
            i += 1

        elif length != 0:
            length = lps[length - 1]

        else:
            lps[i] = 0
            i += 1

    return lps


# -------------------------------------------------
# KMP Algorithm
# -------------------------------------------------
def kmp_search(text, pattern):
    n = len(text)
    m = len(pattern)

    lps = compute_lps(pattern)

    matches = []
    comparisons = 0

    i = 0
    j = 0

    while i < n:

        comparisons += 1

        if pattern[j] == text[i]:
            i += 1
            j += 1

        if j == m:
            matches.append(i - j)
            j = lps[j - 1]

        elif i < n:

            if j != 0:
                j = lps[j - 1]
            else:
                i += 1

    return matches, comparisons


# -------------------------------------------------
# Rabin-Karp Algorithm
# -------------------------------------------------
def rabin_karp(text, pattern, q=101):

    n = len(text)
    m = len(pattern)

    d = 256

    h = pow(d, m - 1, q)

    p_hash = 0
    t_hash = 0

    matches = []

    comparisons = 0

    for i in range(m):
        p_hash = (d * p_hash + ord(pattern[i])) % q
        t_hash = (d * t_hash + ord(text[i])) % q

    for s in range(n - m + 1):

        if p_hash == t_hash:

            matched = True

            for k in range(m):
                comparisons += 1

                if text[s + k] != pattern[k]:
                    matched = False
                    break

            if matched:
                matches.append(s)

        if s < n - m:

            t_hash = (
                d * (t_hash - ord(text[s]) * h)
                + ord(text[s + m])
            ) % q

            if t_hash < 0:
                t_hash += q

    return matches, comparisons


# =================================================
# MAIN PROGRAM
# =================================================

text = "AABAACAADAABAABA"
pattern = "AABA"

print("=" * 50)
print("STRING MATCHING ALGORITHMS")
print("=" * 50)

print("\nText    :", text)
print("Pattern :", pattern)

m1, c1 = naive_search(text, pattern)
m2, c2 = kmp_search(text, pattern)
m3, c3 = rabin_karp(text, pattern)

print("\nNaive Search")
print("Matches      :", m1)
print("Comparisons  :", c1)

print("\nKMP Search")
print("Matches      :", m2)
print("Comparisons  :", c2)

print("\nRabin-Karp Search")
print("Matches      :", m3)
print("Comparisons  :", c3)

# =================================================
# PERFORMANCE ANALYSIS
# =================================================

print("\n")
print("=" * 60)
print("PERFORMANCE ANALYSIS")
print("=" * 60)

text_large = ''.join(random.choices("ABCD", k=10000))

patterns = [
    "AB",
    "ABCD",
    "ABCDAB",
    "ABCDABCD",
    "ABCDABCDAB",
    "ABCDABCDABCD"
]

naive_times = []
kmp_times = []
rk_times = []

print(f'{"Pattern":<15}{"Naive(ms)":>15}{"KMP(ms)":>15}{"RK(ms)":>15}')
print("-" * 60)

for p in patterns:

    # Naive
    start = time.perf_counter()

    for _ in range(100):
        naive_search(text_large, p)

    naive_time = ((time.perf_counter() - start) / 100) * 1000
    naive_times.append(naive_time)

    # KMP
    start = time.perf_counter()

    for _ in range(100):
        kmp_search(text_large, p)

    kmp_time = ((time.perf_counter() - start) / 100) * 1000
    kmp_times.append(kmp_time)

    # Rabin-Karp
    start = time.perf_counter()

    for _ in range(100):
        rabin_karp(text_large, p)

    rk_time = ((time.perf_counter() - start) / 100) * 1000
    rk_times.append(rk_time)

    print(f"{p:<15}{naive_time:>15.5f}{kmp_time:>15.5f}{rk_time:>15.5f}")

# =================================================
# GRAPH
# =================================================

plt.figure(figsize=(10, 6))

plt.plot(
    patterns,
    naive_times,
    marker='o',
    linewidth=2,
    markersize=8,
    label='Naive Search'
)

plt.plot(
    patterns,
    kmp_times,
    marker='s',
    linewidth=2,
    markersize=8,
    label='KMP'
)

plt.plot(
    patterns,
    rk_times,
    marker='^',
    linewidth=2,
    markersize=8,
    label='Rabin-Karp'
)

plt.title("Performance Comparison of String Matching Algorithms")

plt.xlabel("Pattern")

plt.ylabel("Average Execution Time (ms)")

plt.grid(True)

plt.legend()

plt.tight_layout()

plt.show()