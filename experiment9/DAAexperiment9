def first_fit(items, capacity=1.0):
    # Each bin stores remaining space
    bins = []
    bin_contents = []

    for item in items:
        placed = False

        # Try to place item in the first bin where it fits
        for i, space in enumerate(bins):

            if space >= item:
                bins[i] -= item
                bin_contents[i].append(item)
                placed = True
                break

        # If item cannot fit in any existing bin
        if not placed:
            bins.append(capacity - item)
            bin_contents.append([item])

    return bin_contents


def first_fit_decreasing(items, capacity=1.0):
    # Sort items in decreasing order
    sorted_items = sorted(items, reverse=True)

    return first_fit(sorted_items, capacity)


def best_fit_decreasing(items, capacity=1.0):
    # Sort items in decreasing order
    sorted_items = sorted(items, reverse=True)

    bins = []
    bin_contents = []

    for item in sorted_items:

        best_idx = -1
        best_space = float('inf')

        # Find the bin with the smallest remaining
        # space that can still fit the item
        for i, space in enumerate(bins):

            if space >= item and space - item < best_space:
                best_space = space - item
                best_idx = i

        # Place item in the best bin
        if best_idx >= 0:
            bins[best_idx] -= item
            bin_contents[best_idx].append(item)

        # Otherwise create a new bin
        else:
            bins.append(capacity - item)
            bin_contents.append([item])

    return bin_contents


def display_bins(label, bins):
    print(f"\n{label}: {len(bins)} bins")

    for i, b in enumerate(bins, 1):

        used = sum(b)

        # Create visual bar
        bar = '#' * int(used * 20)

        print(
            f" Bin {i}: "
            f"{[round(x, 1) for x in b]} "
            f"| Used: {used:.1f} "
            f"[{bar:<20}]"
        )


